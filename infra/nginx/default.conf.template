server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 30m;

    # Resolve the API hostname at request time instead of at startup. A literal
    # `proxy_pass http://verity-api:4000` is resolved while nginx parses this
    # file, and nginx refuses to boot if that fails:
    #   [emerg] host not found in upstream "verity-api"
    # That happens whenever the API is still deploying, on Render's free plan
    # (no private networking, so bare service names do not resolve), or when a
    # public hostname is temporarily unresolvable. Assigning the upstream to a
    # variable defers resolution to each request, so nginx always starts and an
    # unreachable API surfaces as a 502 that falls back to the login page.
    set $api_upstream "${API_UPSTREAM}";
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;

    # Needed when API_UPSTREAM is an https:// public URL (free plan); ignored
    # for plain-http upstreams on the private network.
    proxy_ssl_server_name on;

    # SSE + long-running chat streams.
    proxy_http_version 1.1;
    # $proxy_host keeps the upstream's own hostname in the Host header. This
    # matters for public https upstreams, where the wrong Host header would be
    # routed back to this frontend by the platform's edge.
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header Connection '';
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    chunked_transfer_encoding on;
    add_header X-Accel-Buffering no;

    # Liveness probe for the platform. Must not depend on the API, otherwise a
    # deploying API marks the whole frontend unhealthy.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        proxy_pass $api_upstream;
    }

    # Internal session verification subrequest
    location = /_auth_verify {
        internal;
        proxy_pass $api_upstream/api/auth/verify$is_args$args;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
    }

    # Public static assets
    location /assets/ {
        try_files $uri =404;
    }

    location = /verity-logo.png {
        try_files $uri =404;
    }

    location = /login-page-bg.jpg {
        try_files $uri =404;
    }

    location = /favicon.ico {
        try_files $uri =404;
    }

    # Public authentication route
    location /login {
        auth_request off;
        try_files /index.html =404;
    }

    location /dev/ {
        auth_request off;
        try_files /index.html =404;
    }

    # Protected pages require a valid session
    location / {
        auth_request /_auth_verify;
        error_page 401 = @login_redirect;
        # If the auth subrequest can't reach the API (e.g. it is still
        # deploying), fall back to the login page instead of a 500.
        error_page 500 502 503 504 = @login_redirect;
        try_files $uri $uri/ /index.html;
    }

    location @login_redirect {
        return 302 /login?redirect=$request_uri;
    }
}
