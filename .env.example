# ---------------------------------------------------------------------------
# Verity environment template
#
# Copy this file to `.env` and change every value marked `change-me` before
# using anything other than a local demo. `.env` is gitignored; never commit it.
# ---------------------------------------------------------------------------

# General
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Gateway
API_PORT=4000
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
JWT_ISSUER=verity
JWT_AUDIENCE=verity-api
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Postgres
# The official Postgres image needs a superuser for init/migrations.
# Application traffic uses the two least-privilege roles below instead.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=verity
POSTGRES_SUPERUSER=postgres
POSTGRES_PASSWORD=change-me-superuser
VERITY_APP_USER=verity_app
VERITY_APP_PASSWORD=change-me-app
SQL_RO_USER=verity_sql_ro
SQL_RO_PASSWORD=change-me-ro

# Redis / MinIO
REDIS_URL=redis://redis:6379
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=verity-minio
MINIO_SECRET_KEY=change-me-minio
MINIO_BUCKET=verity-docs

# AI service
AI_SERVICE_URL=http://ai:8000
LLM_PROVIDER=google
# Override this when your provider/key uses a different model id.
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
RERANKER=none
COHERE_API_KEY=

# RAG tuning
CHUNK_TOKENS=650
CHUNK_OVERLAP=100
RETRIEVE_TOP_K=30
RERANK_CANDIDATES=20
RERANK_TOP_N=6
MIN_RERANK_SCORE=0.25

# SQL safety
SQL_MAX_ROWS=200
SQL_MAX_ROWS_HARD=1000
SQL_TIMEOUT_MS=5000
SQL_MAX_REPAIRS=2
SQL_MAX_JOINS=5
SQL_MAX_SUBQUERY_DEPTH=3

# Uploads / rate limits
UPLOAD_MAX_MB=25
AUTH_RATE_LIMIT_PER_MIN=10
CHAT_RATE_LIMIT_PER_MIN=20
UPLOAD_RATE_LIMIT_PER_HOUR=10

# Observability (Phase 6)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
TRACE_REDACT_PROMPTS=false

# Demo seed users (development only — documented in the README)
SEED_ADMIN_EMAIL=admin@verity.dev
SEED_ADMIN_PASSWORD=verity-admin-dev
SEED_ANALYST_EMAIL=analyst@verity.dev
SEED_ANALYST_PASSWORD=verity-analyst-dev
SEED_VIEWER_EMAIL=viewer@verity.dev
SEED_VIEWER_PASSWORD=verity-viewer-dev
